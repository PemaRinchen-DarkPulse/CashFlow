# dotenv only parses KEY=value. A line written as "KEY: value" is skipped
# silently, and the server then exits saying the variable is missing.
PORT=5000

# Include the database name after the host, before the "?" — without it the
# driver falls back to a database called "test".
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/cashflow?retryWrites=true&w=majority

# Signs session tokens. Any long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out.
JWT_SECRET=your_generated_random_secret

# Brevo (Email Sending)
# The key comes from Brevo > SMTP & API > the "API keys" tab, and starts with
# "xkeysib-". The "SMTP" tab next to it issues SMTP keys ("xsmtpsib-") — those
# are passwords for smtp-relay.brevo.com, and the REST API this server calls
# answers 401 "Key not found" if given one.
# EMAIL_FROM must be an address verified under Brevo > Senders, or every send
# is rejected.
BREVO_API_KEY=xkeysib-your_actual_brevo_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=CashFlow App
