# The port the CashFlow API listens on. Must match PORT in server/.env.
#
# The host is not configured here: the app takes it from whichever address the
# phone used to reach Metro, so a new Wi-Fi network or a new DHCP lease needs no
# edit. EXPO_PUBLIC_ variables are inlined into the bundle at build time, so this
# is readable by anyone with the app — config, never a secret.
#
# After changing it, restart Metro with `npx expo start -c`.
EXPO_PUBLIC_API_PORT=5000

# Set this only for a build that talks to a deployed server rather than to the
# machine running Metro. When present it replaces the whole address above.
# EXPO_PUBLIC_API_URL=https://api.example.com
