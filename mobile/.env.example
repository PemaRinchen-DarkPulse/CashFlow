# The port the CashFlow API listens on while you develop. Must match PORT in
# server/.env. The host is not set here: the app takes it from whichever
# address the phone used to reach Metro.
#
# After changing it, restart Metro with `npx expo start -c`.
EXPO_PUBLIC_API_PORT=5000

# Do not set EXPO_PUBLIC_API_URL in .env for day-to-day work — that would send
# Expo Go at Vercel instead of your machine. Released builds already point at
# https://cash-flow-server-fawn.vercel.app. Override only for a one-off APK:
# EXPO_PUBLIC_API_URL=https://cash-flow-server-fawn.vercel.app
