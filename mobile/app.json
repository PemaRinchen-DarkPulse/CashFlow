{
  "expo": {
    "name": "CashFlow",
    "slug": "cashflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cashflow",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05090B",
    "primaryColor": "#1DD75B",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05090B"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#05090B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.pemarinchen12.cashflow",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#05090B",
          "dark": {
            "backgroundColor": "#05090B"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CashFlow to use Face ID to sign you in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CashFlow to use your photos for your profile and for pictures of what you are saving for.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7241a9f3-7e33-4241-8083-978e38f250df"
      }
    }
  }
}
